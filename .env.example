# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_bot_token_here

# Admin Telegram User IDs (pisahkan dengan koma jika lebih dari satu)
ADMIN_IDS=123456789

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/botjaseb

# Telegram API credentials (dari https://my.telegram.org/apps)
API_ID=your_api_id
API_HASH=your_api_hash

# Info bot (untuk pesan sambutan)
BOT_OWNER=@YourChannel
BOT_CHANNEL=@YourChannel
BOT_NAME=YourBotName

NOTIFY_BOT_TOKEN=your_notify_bot_token
NOTIFY_BOT_USERNAME=your_notify_bot_username
